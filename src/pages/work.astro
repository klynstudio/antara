---
/*
  Project index. Everything, in reverse order of completion.
*/
import Base from './_components/Base.astro';
import Figure from './_components/Figure.astro';
import { projects } from './_data/projects.ts';

const ordered = [...projects].sort((a, b) => b.year - a.year);
---

<Base title="Projects" current="work" description="Houses and interiors by Antara.">
  <section class="wrap" style="padding-top:clamp(110px,16vh,190px)">
    <p class="label" data-reveal>Projects</p>
    <h1 class="display" data-split style="margin-top:14px;max-width:14ch">Thirty-one houses. Five of them here.</h1>
    <p data-reveal data-delay="2" class="muted" style="margin-top:22px;max-width:52ch">
      Most of our work is private and stays that way. These five are shown with
      the owners&rsquo; permission and cover the range &mdash; a house on a narrow
      plot, one on a hill, a studio, a corner in Goa, and a flat stripped back.
    </p>
  </section>

  <section class="wrap section">
    <div class="projects stagger">
      {ordered.map((p, i) => (
        <a class="pcard" href={`/work/${p.slug}`}>
          <Figure
            file={p.cover}
            ratio={i % 2 === 0 ? '3/2' : '4/3'}
            caption={`${p.name} — ${p.place}`}
            class="pcard-fig"
            alt={`${p.name}, ${p.place}`}
            eager={i === 0}
            transition={`p-${p.slug}`}
          />
          <div class="pcard-row">
            <h2 class="pcard-name">{p.name}</h2>
            <span class="pcard-meta">
              {p.type} &middot; {p.place} &middot; {p.status === 'Completed' ? p.year : p.status}
            </span>
          </div>
          <p class="pcard-lede">{p.lede}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
