---
/*
  Shell for every Antara page.

  Deliberately does not use the Klyn layout — no loader, no custom cursor, no
  grain. This is meant to read as a different studio's work: one typeface, one
  stylesheet, and one motion script (_scripts/motion.ts).
*/
import '../_styles/antara.css';
import { studio, disclosure } from '../_data/site.ts';

export interface Props {
  title: string;
  description?: string;
  current?: 'work' | 'studio' | 'contact' | null;
}

const { title, description = studio.line, current = null } = Astro.props;

const nav = [
  { label: 'Projects', href: '/work', key: 'work' },
  { label: 'Studio', href: '/studio', key: 'studio' },
  { label: 'Contact', href: '#contact', key: 'contact' },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <!--
      `js` lets the stylesheet hide things that are about to animate without
      hiding them from visitors who have no script. `no-loader` skips the
      opening screen after the first page. `is-vt` marks an arrival by view
      transition, so the hero skips its opening and the cover can land.
    -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add('js');
        /* The loader plays once per visit; after that pages open straight onto content */
        try {
          if (sessionStorage.getItem('antara-seen')) html.classList.add('no-loader');
          /* The opening should always open onto the hero, not wherever a reload left off */
          else if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}
        window.addEventListener('pagereveal', function (e) {
          if (e.viewTransition) html.classList.add('is-vt', 'no-loader');
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- A concept piece living inside another studio's site; it should not be indexed -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — {studio.name}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>

  <body>
    <!--
      Opening screen, first page of a visit only. Holds until the typeface and
      the first photograph are ready, so the hero opens complete rather than
      assembling itself in front of you.
    -->
    <div class="loader" id="loader" aria-hidden="true">
      <div class="loader-row">
        <span>{studio.name}</span>
        <span class="loader-n" id="loader-n">00</span>
      </div>
      <div class="loader-bar"><span id="loader-bar"></span></div>
    </div>

    <header class="nav" id="nav">
      <a class="nav-mark" href="/">
        {studio.name} <span>&mdash; {studio.discipline}</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        {nav.map((n) => (
          <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <section class="cta" id="contact">
      <div class="wrap section">
        <p class="label" data-reveal>Contact</p>

        <!--
          The address gets a row to itself. Inside the two-column grid it was
          overrunning its column and printing straight through the paragraph
          beside it — an email is one unbreakable word, so it cannot reflow its
          way out of a narrow column the way a sentence can.
        -->
        <a class="big" href={`mailto:${studio.email}`} data-reveal>{studio.email}</a>

        <div class="cta-cols">
          <p data-reveal data-delay="1">
            We answer every enquiry ourselves, usually within two days. If you are
            deciding whether to build at all, say so &mdash; that is a different
            and shorter conversation.
          </p>
          <p data-reveal data-delay="2">
            {studio.phone}<br />
            {studio.city}, {studio.country}
          </p>
        </div>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <p class="label">{studio.name}</p>
            <p style="margin-top:8px">{studio.discipline}<br />Since {studio.founded}</p>
          </div>
          <div>
            <p class="label">Pages</p>
            <p style="margin-top:8px">
              <a href="/">Home</a><br />
              <a href="/work">Projects</a><br />
              <a href="/studio">Studio</a>
            </p>
          </div>
          <div>
            <p class="label">Contact</p>
            <p style="margin-top:8px">
              <a href={`mailto:${studio.email}`}>{studio.email}</a><br />
              {studio.phone}
            </p>
          </div>
          <div>
            <p class="label">Studio</p>
            <p style="margin-top:8px">{studio.city}<br />{studio.country}</p>
          </div>
        </div>

        <div class="foot-note">
          <span>&copy; {year} {studio.name}</span>
          <span style="max-width:64ch">{disclosure}</span>
        </div>
      </div>
    </footer>

    <script>
      import '../_scripts/motion.ts';
    </script>
  </body>
</html>
